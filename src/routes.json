{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0",
    "fhir2": ">=1.2"
  },
  "extensions": [
    {
      "name": "omnibar",
      "component": "omnibar",
      "slot": "top-nav-actions-slot",
      "order": 0
    },
    {
      "name": "omnibar-patient-search-provider",
      "component": "patientSearchProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Patients"],
      "meta": { "lane": "record", "scopes": ["global", "patient"], "order": 10, "patientScopeOrder": 30 }
    },
    {
      "name": "omnibar-chart-lookup-provider",
      "component": "chartLookupProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Observations"],
      "meta": { "lane": "record", "scopes": ["patient"], "order": 10, "defaultInChart": true }
    },
    {
      "name": "omnibar-chartsearch-suggestion-provider",
      "component": "chartSearchSuggestionProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["AI Query Patient Data"],
      "meta": { "lane": "navigate", "scopes": ["patient"], "order": 100 }
    },
    {
      "name": "omnibar-destinations-provider",
      "component": "destinationsProvider",
      "slot": "omnibar-providers-slot",
      "meta": { "lane": "navigate", "scopes": ["global", "patient"], "order": 10, "defaultInChart": true }
    },
    {
      "name": "omnibar-cohort-criteria-provider",
      "component": "cohortCriteriaProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Patients", "Run Reports"],
      "meta": { "lane": "navigate", "scopes": ["global"], "order": 20 }
    },
    {
      "name": "omnibar-cohort-builder-provider",
      "component": "cohortBuilderProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Patients", "Run Reports"],
      "meta": { "lane": "navigate", "scopes": ["global"], "order": 30 }
    },
    {
      "name": "omnibar-saved-cohorts-provider",
      "component": "savedCohortsProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Patient Cohorts", "Get Patients", "Run Reports"],
      "meta": { "lane": "navigate", "scopes": ["global"], "order": 40 }
    },
    {
      "name": "omnibar-saved-queries-provider",
      "component": "savedQueriesProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["View Reports", "Run Reports", "Get Patients"],
      "meta": { "lane": "navigate", "scopes": ["global"], "order": 50 }
    }
  ]
}
