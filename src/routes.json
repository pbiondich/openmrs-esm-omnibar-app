{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0",
    "fhir2": ">=1.2"
  },
  "pages": [
    {
      "component": "sessionChangePage",
      "routeRegex": "^log(?:in|out)(?:/|$)",
      "online": true,
      "offline": true
    }
  ],
  "extensions": [
    {
      "name": "omnibar",
      "component": "omnibar",
      "slot": "top-nav-actions-slot",
      "order": 0
    },
    {
      "name": "omnibar-patient-search-provider",
      "component": "patientSearchProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Patients"],
      "meta": { "lane": "record", "scopes": ["global", "patient"], "order": 10, "patientScopeOrder": 30, "contract": 1, "command": { "id": "patient", "aliases": ["patient", "pt", "find"] } }
    },
    {
      "name": "omnibar-chart-lookup-provider",
      "component": "chartLookupProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["Get Observations"],
      "meta": { "lane": "record", "scopes": ["patient"], "order": 10, "defaultInChart": true, "contract": 1, "dedupeKey": "chart-values", "command": { "id": "lab", "aliases": ["lab", "labs", "results", "obs", "value"] } }
    },
    {
      "name": "omnibar-destinations-provider",
      "component": "destinationsProvider",
      "slot": "omnibar-providers-slot",
      "meta": { "lane": "navigate", "scopes": ["global", "patient"], "order": 10, "defaultInChart": true, "contract": 1, "command": { "id": "go", "aliases": ["go", "open", "page"] } }
    },
    {
      "name": "omnibar-query-results-dashboard",
      "component": "queryResultsDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "order": 100,
      "meta": { "slot": "omnibar-query-results-dashboard-slot", "path": "query-results", "title": "Query results" }
    },
    {
      "name": "omnibar-query-results-page",
      "component": "queryResultsPage",
      "slot": "omnibar-query-results-dashboard-slot",
      "meta": { "fullWidth": true }
    },
    {
      "name": "omnibar-chart-values-view",
      "component": "chartValuesView",
      "slot": "omnibar-query-results-slot",
      "privileges": ["Get Observations"],
      "meta": { "scopes": ["patient"], "order": 10, "contract": 1, "command": { "id": "lab" } }
    }
  ]
}
