# Example environment for the e2e tests. Copy to .env (gitignored) and fill in an account on your own
# test server. Nothing reads this file directly; the placeholders below are not real credentials.
E2E_BASE_URL=http://localhost:8080/openmrs
E2E_USER_ADMIN_USERNAME=change-me
E2E_USER_ADMIN_PASSWORD=change-me
E2E_LOGIN_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
# The above location UUID is for the "Outpatient Clinic" location in the reference application
